{
  "name": "aisenlens",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @aisenlens/web dev",
    "build": "pnpm --filter @aisenlens/web build",
    "preview": "pnpm --filter @aisenlens/web preview",
    "format": "pnpm --filter @aisenlens/web format",
    "test:video-export": "pnpm --filter @aisenlens/web test:video-export",
    "dev:desktop": "pnpm --filter @aisenlens/desktop dev",
    "build:desktop": "pnpm --filter @aisenlens/desktop build",
    "sync:mobile": "pnpm --filter @aisenlens/mobile sync",
    "open:android": "pnpm --filter @aisenlens/mobile open:android",
    "open:ios": "pnpm --filter @aisenlens/mobile open:ios"
  }
}
