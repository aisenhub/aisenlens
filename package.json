    "typecheck:webhome": "pnpm --filter @aisenlens/webhome typecheck",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:webapp": "node scripts/verify-webapp.mjs",
    "verify:webhome": "node scripts/verify-webhome.mjs",
    "verify:web-boundaries": "node scripts/verify-web-boundaries.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "test:workflow-browser": "node --test tests/features/workflow/workflow-end-to-end.browser.test.js",
    "preview": "pnpm --filter @aisenlens/webapp preview",
    "preview:webapp": "pnpm --filter @aisenlens/webapp preview",
    "preview:webhome": "pnpm --filter @aisenlens/webhome preview",
    "format": "pnpm --filter @aisenlens/webapp format",
    "test:auto-shot-contract": "pnpm --filter @aisenlens/webapp test:auto-shot-contract",
    "test:auto-shot-config": "pnpm --filter @aisenlens/webapp test:auto-shot-config",
    "test:auto-shot-settings-store": "pnpm --filter @aisenlens/webapp test:auto-shot-settings-store",
    "test:scene-calibration": "pnpm --filter @aisenlens/webapp test:scene-calibration",
    "test:shot-calibration": "pnpm --filter @aisenlens/webapp test:shot-calibration",
    "test:shot-calibration-browser": "pnpm --filter @aisenlens/webapp test:shot-calibration-browser",
    "scene-calibration": "node --experimental-strip-types scripts/scene-calibration.mjs",
    "test:editor-history": "pnpm --filter @aisenlens/webapp test:editor-history",
    "test:retain-shot-map": "pnpm --filter @aisenlens/webapp test:retain-shot-map",
    "test:overview-analyze": "pnpm --filter @aisenlens/webapp test:overview-analyze",
    "test:overview-analyze-browser": "pnpm --filter @aisenlens/webapp test:overview-analyze-browser",
    "test:analysis-system-browser": "pnpm --filter @aisenlens/webapp test:analysis-system-browser",
    "test:analysis-consumer-browser": "pnpm --filter @aisenlens/webapp test:analysis-consumer-browser",
    "test:auto-shot-baseline": "pnpm --filter @aisenlens/webapp test:auto-shot-baseline",
    "generate:auto-shot-fixture": "node scripts/generate-auto-shot-fixture.mjs",
    "scene-engine:configure": "pnpm --filter @aisenlens/scene-engine configure:native",
    "scene-engine:build": "pnpm --filter @aisenlens/scene-engine build:native",
    "scene-engine:test": "pnpm --filter @aisenlens/scene-engine test:native",
    "scene-engine:configure:wasm": "pnpm --filter @aisenlens/scene-engine configure:wasm",
    "scene-engine:build:wasm": "pnpm --filter @aisenlens/scene-engine build:wasm",
    "scene-engine:configure:wasm:simd": "pnpm --filter @aisenlens/scene-engine configure:wasm:simd",
    "scene-engine:build:wasm:simd": "pnpm --filter @aisenlens/scene-engine build:wasm:simd",
    "scene-engine:test:simd": "pnpm --filter @aisenlens/scene-engine test:simd",
    "scene-engine:benchmark:simd": "pnpm --filter @aisenlens/scene-engine benchmark:simd",
    "scene-engine:typecheck": "pnpm --filter @aisenlens/scene-engine typecheck",
    "scene-engine:test:contract": "pnpm --filter @aisenlens/scene-engine test:contract",
    "scene-engine:verify:web-build": "node scripts/verify-scene-engine-web-build.mjs",
    "scene-engine:verify:web-preview": "node scripts/verify-scene-engine-web-preview.mjs",
    "scene-engine:verify:core": "node scripts/verify-scene-engine-core.mjs",
    "test:video-export": "pnpm --filter @aisenlens/webapp test:video-export",
    "dev:desktop": "pnpm --filter @aisenlens/desktop dev",
    "build:desktop": "pnpm --filter @aisenlens/desktop build",
    "sync:mobile": "pnpm --filter @aisenlens/mobile sync",
    "open:android": "pnpm --filter @aisenlens/mobile open:android",
    "open:ios": "pnpm --filter @aisenlens/mobile open:ios"
  }
}
