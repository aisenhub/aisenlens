    "dev:webhome": "pnpm --filter @aisenlens/webhome dev",
    "build": "pnpm run build:web",
    "build:webapp": "pnpm --filter @aisenlens/webapp build",
    "build:webhome": "pnpm --filter @aisenlens/webhome build",
    "build:web": "pnpm run build:webapp && pnpm run build:webhome",
    "lint": "pnpm --filter @aisenlens/webapp lint",
    "lint:webapp": "pnpm --filter @aisenlens/webapp lint",
    "lint:webhome": "pnpm --filter @aisenlens/webhome lint",
    "typecheck": "pnpm --filter @aisenlens/webapp typecheck",
