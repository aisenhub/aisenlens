{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.aisenhub.com/projects",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "https://app.aisenhub.com/projects",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
