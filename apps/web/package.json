{
  "name": "@aisenlens/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postbuild": "node ../../scripts/prerender-public-routes.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:auto-shot-contract": "node --test test/auto-shot-contract.test.js",
    "test:auto-shot-task-state": "node --experimental-strip-types --test test/auto-shot-task-state.test.ts",
    "test:auto-shot-adapter": "node --experimental-strip-types --test test/auto-shot-scene-result-adapter.test.ts",
    "test:auto-shot-media-fingerprint": "node --experimental-strip-types --test test/auto-shot-media-fingerprint.test.ts",
    "test:auto-shot-task-service": "node --experimental-strip-types --test test/auto-shot-task-service.test.ts",
    "test:auto-shot-config": "node --test test/auto-shot-config.test.mjs",
    "test:auto-shot-settings-store": "node --test test/auto-shot-settings-store.test.mjs",
    "test:scene-calibration": "node --experimental-strip-types --test test/scene-calibration.test.ts",
    "test:shot-calibration": "node --experimental-strip-types --test ../../tests/features/shot-calibration/*.test.ts",
    "test:shot-calibration-browser": "node --test ../../tests/features/shot-calibration/calibration-workflow.browser.test.js ../../tests/features/shot-calibration/calibration-real-media.browser.test.js ../../tests/features/shot-calibration/calibration-verification.browser.test.js",
    "test:editor-history": "node --experimental-strip-types --test test/editor-history-state.test.ts",
    "test:analysis-contract": "node --experimental-strip-types --test test/analysis-ai-contract.test.ts",
    "test:analysis-template-contract": "node --experimental-strip-types --test test/analysis-template-contract.test.ts",
    "test:analysis-system-browser": "node --test ../../tests/features/analysis-system/analysis-system.browser.test.js",
    "test:analysis-consumer-browser": "node --test ../../tests/features/analysis-system/analysis-consumer-matrix.browser.test.js",
    "test:retain-shot-map": "node --experimental-strip-types --test test/retain-shot-map.test.ts",
    "test:overview-analyze": "node --experimental-strip-types --test ../../tests/features/overview-analyze/*.test.ts",
    "test:overview-analyze-browser": "node --test ../../tests/features/overview-analyze/overview-analyze.browser.test.js",
    "test:auto-shot-baseline": "node --test test/auto-shot-baseline.browser.test.js",
    "test:video-export": "node --test test/video-export.browser.test.js",
    "test:video-export-boundary": "node --experimental-strip-types --test test/video-export-boundary.test.ts",
    "test:platform-integration": "node --experimental-strip-types --test test/platform-integration.test.ts"
  },
  "dependencies": {
    "@aisenlens/scene-engine": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mediabunny": "1.29.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.0"
  }
}
