# Dependencies and package-manager data
node_modules/
.pnpm-store/

# Build outputs and generated reports
dist/
build/
coverage/
test-results/
playwright-report/

# The Web product imports these prebuilt WASM runtime assets. Keep the
# Emscripten build directories ignored, but version the four deployable files
# so cloud builders do not need a local Emscripten toolchain.
!packages/
!packages/scene-engine/
!packages/scene-engine/dist/
!packages/scene-engine/dist/wasm/
!packages/scene-engine/dist/wasm/scene-engine.js
!packages/scene-engine/dist/wasm/scene-engine.wasm
!packages/scene-engine/dist/wasm-simd/
!packages/scene-engine/dist/wasm-simd/scene-engine-simd.js
!packages/scene-engine/dist/wasm-simd/scene-engine-simd.wasm

# Keep browser test code in Git; ignore only large local video fixtures.
apps/web/test/*.mov
apps/web/test/*.mp4
apps/web/test/*.webm
apps/web/test/fixtures/auto-shot/*.mov
apps/web/test/fixtures/auto-shot/*.mp4
apps/web/test/fixtures/auto-shot/*.webm
apps/*/dist/
apps/*/release/
apps/*/node_modules/
apps/desktop/.electron/
apps/desktop/.webpack/

# Local environment and deployment state
.env
.env.*
!.env.example
# Vite's web application reads its local settings from this file.
apps/web/.env.local
.vercel/

# Local tool caches and logs
.cache/
.vite/
.turbo/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Keep only the verified reference index, not imported reference sources.
reference-projects/*
!reference-projects/REFERENCE_PROJECT_INDEX.md
