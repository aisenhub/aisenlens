# Dependencies and package-manager data
node_modules/
.pnpm-store/

# Build outputs and generated reports
dist/
build/
coverage/
test-results/
playwright-report/
# Keep browser test code in Git; ignore only large local video fixtures.
apps/web/test/*.mov
apps/web/test/*.mp4
apps/web/test/*.webm
apps/*/dist/
apps/*/release/
apps/*/node_modules/
apps/desktop/.electron/
apps/desktop/.webpack/

# Local environment and deployment state
.env
.env.*
!.env.example
# Vite's web application reads its local settings from this file.
apps/web/.env.local
.vercel/

# Local tool caches and logs
.cache/
.vite/
.turbo/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Keep only the verified reference index, not imported reference sources.
reference-projects/*
!reference-projects/REFERENCE_PROJECT_INDEX.md
